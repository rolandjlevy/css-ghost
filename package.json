{
  "name": "@rolandjlevy/css-ghost",
  "version": "1.0.1",
  "description": "Find orphaned CSS class selectors in your codebase",
  "type": "module",
  "bin": {
    "css-ghost": "bin/css-ghost.js"
  },
  "scripts": {
    "start": "node bin/css-ghost.js",
