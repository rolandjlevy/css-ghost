{
  "name": "css-ghost",
  "version": "1.3.1",
  "description": "Find and remove unused CSS selectors and orphaned CSS custom properties — a CLI linter and auditor for React, Vue, Svelte, SCSS, and CSS Modules",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "bin": {
    "css-ghost": "bin/css-ghost.js"
  },
  "scripts": {
    "start": "node bin/css-ghost.js",
    "scan": "node bin/css-ghost.js ./test",
    "scan:trail": "node bin/css-ghost.js ./test --ghost-trail",
    "delete": "node bin/css-ghost.js ./test --delete",
    "delete:yes": "node bin/css-ghost.js ./test --delete --yes",
    "setup": "node bin/css-ghost.js --setup",
    "test": "node test/run.js"
  },
  "files": [
    "bin",
    "src",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "unused",
    "orphan",
    "orphaned-selectors",
    "selectors",
    "dead-code",
    "cleanup",
    "cli",
    "linter",
    "audit",
    "tree-shaking",
    "custom-properties",
    "css-variables",
    "react",
    "vue",
    "svelte",
    "scss",
    "css-modules",
    "purgecss",
    "vite",
    "webpack",
    "postcss",
    "vanilla-extract",
    "style-audit"
  ],
  "author": "Roland Levy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolandjlevy/css-ghost.git"
  },
  "homepage": "https://github.com/rolandjlevy/css-ghost#readme",
  "bugs": {
    "url": "https://github.com/rolandjlevy/css-ghost/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
